# Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Backend ───────────────────────────────────────────────────────────────────
# Database URL (SQLite by default; swap to postgresql+asyncpg://... for Postgres)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Secret key for internal signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-in-production

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Data directory (where MovieLens files live after download)
DATA_DIR=./data

# Experiments directory (where run artifacts are written)
EXPERIMENTS_DIR=./experiments

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── ML / Evaluation ───────────────────────────────────────────────────────────
# Global random seed (used for reproducible splits and model training)
RANDOM_SEED=42

# Number of seeds for multi-seed evaluation
N_EVAL_SEEDS=5

# Top-K for ranking metrics
TOP_K=10

# Minimum ratings per user/item (below this, the user/item is dropped)
MIN_USER_RATINGS=5
MIN_ITEM_RATINGS=1

# Train/val/test split ratios (must sum to 1.0)
TRAIN_RATIO=0.70
VAL_RATIO=0.10
TEST_RATIO=0.20

# ── TMDB (optional) ───────────────────────────────────────────────────────────
# If not set, the app falls back to genre-colored placeholder images.
# TMDB_API_KEY=your-key-here

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL of the backend API (used by Next.js server components and API routes)
NEXT_PUBLIC_API_URL=http://localhost:8000
